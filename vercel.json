{
  "headers": [
    {
      "source": "/((?!feedback$|feedback\\.html$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(feedback|feedback\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feedback/board",
      "destination": "/board.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/:deal([0-9]+)",
      "destination": "/deal.html"
    }
  ],
  "cleanUrls": false,
  "functions": {
    "api/proposal-pdf.js": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/intake.js": {
      "maxDuration": 90
    },
    "api/handoff-pdf.js": {
      "maxDuration": 90,
      "memory": 2048
    }
  }
}